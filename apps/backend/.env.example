# Haanta backend (Medusa) environment. Copy to .env for local development.
# Placeholders only: real values live in the host's secret store and are never committed.
# Every third-party service has a local mock; leave its keys empty to use the mock.

# --- Core
NODE_ENV=development
APP_ENV=local
DATABASE_URL=postgres://haanta:<password>@127.0.0.1:54329/haanta
REDIS_URL=
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
MEDUSA_DISABLE_TELEMETRY=true
DISABLE_MEDUSA_ADMIN=false
STOREFRONT_URL=http://localhost:3000
VENDOR_PORTAL_URL=http://localhost:3001
ADMIN_URL=http://localhost:9000/app

# --- CORS
STORE_CORS=http://localhost:3000
VENDOR_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# --- Secrets (generate long random values, e.g. `openssl rand -base64 48`)
JWT_SECRET=<random>
JWT_EXPIRES_IN=1d
COOKIE_SECRET=<random>
MFA_ENCRYPTION_KEY=<random 32 bytes, base64>
MFA_RECOVERY_PEPPER=<random>
UPLOAD_SIGNING_SECRET=<random>

# --- Security services
TURNSTILE_SECRET_KEY=
HIBP_ENABLED=false
# Local e2e only: multiplies rate limits so one machine can run the whole suite. Ignored in production.
RATE_LIMIT_SCALE=

# --- Payments (empty = local mocks)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=<random for local mock signatures>
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_MOCK_WEBHOOK_SECRET=<random>

# --- Shipping (empty = local mocks)
UPS_BASE_URL=https://wwwcie.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_SHIPPER_NUMBER=
UPS_SHIP_FROM_NAME=
UPS_SHIP_FROM_ADDRESS=
UPS_SHIP_FROM_CITY=
UPS_SHIP_FROM_STATE=
UPS_SHIP_FROM_POSTAL=
SHIPENGINE_API_KEY=
SHIPENGINE_WEBHOOK_TOKEN=
FX_PROVIDER=fixed

# --- Search, media, email, monitoring (empty = local mocks)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX=haanta_products
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_NEWSLETTER_LIST_ID=
HAANTA_OPS_EMAIL=ops@example.com
SENTRY_DSN=

# --- Local seed and e2e fixtures (never used in production)
SEED_ADMIN_EMAIL=admin@haanta.local
SEED_ADMIN_PASSWORD=<local password>
E2E_VENDOR_EMAIL=e2e-vendor@haanta.local
E2E_VENDOR_PASSWORD=<local password>
E2E_VENDOR_TOTP_SECRET=<base32 secret>
